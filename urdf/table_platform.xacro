<?xml version="1.0" ?>
<robot name="table_platform" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="wood_material">
        <color rgba="0.8 0.52 0.25 1.0"/>
    </material>
    <material name="table_leg_material">
        <color rgba="0.4 0.25 0.1 1.0"/>
    </material>

    <link name="table_link">
        <!-- Wooden Table Top Board -->
        <visual>
            <origin xyz="0.25 0 0.18" rpy="0 0 0"/>
            <geometry>
                <box size="1.15 0.80 0.04"/>
            </geometry>
            <material name="wood_material"/>
        </visual>
        <collision>
            <origin xyz="0.25 0 0.18" rpy="0 0 0"/>
            <geometry>
                <box size="1.15 0.80 0.04"/>
            </geometry>
        </collision>

        <!-- Wooden Base Support Block -->
        <visual>
            <origin xyz="0.25 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="1.10 0.76 0.16"/>
            </geometry>
            <material name="table_leg_material"/>
        </visual>
        <collision>
            <origin xyz="0.25 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="1.10 0.76 0.16"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.25 0 0.10" rpy="0 0 0"/>
            <mass value="50.0"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <gazebo reference="table_link">
        <material>Gazebo/Wood</material>
    </gazebo>

</robot>
