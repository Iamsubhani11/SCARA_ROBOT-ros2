      </inertial>

      <!-- Main Yellow Puck Base -->
      <visual name="puck_body_visual">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.035</length>
          </cylinder>
