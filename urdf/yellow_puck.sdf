      <!-- Top Loop Handle -->
      <visual name="puck_handle_visual">
        <pose>0 0 0.045 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.85 0.0 1</ambient>
          <diffuse>1.0 0.85 0.0 1</diffuse>
        </material>
      </visual>

      <!-- Collisions -->
      <collision name="puck_body_collision">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.035</length>
          </cylinder>
